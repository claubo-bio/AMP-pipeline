<ROSETTASCRIPTS>

    <SCOREFXNS>

        <ScoreFunction
            name="beta"
            weights="beta"
        />

        <ScoreFunction
            name="beta_cst"
            weights="beta_cst"
        />

    </SCOREFXNS>

    <MOVERS>

        <!-- Add a virtual root for the relaxation setup -->
        <VirtualRoot
            name="set_virtual_root"
        />

        <!-- Keep the backbone close to the input structure -->
        <AddConstraints
            name="add_bb_ca_cst"
        >
            <CoordinateConstraintGenerator
                name="set_bb_ca_constraint"
                native="false"
                ca_only="true"
            />
        </AddConstraints>

        <!-- Perform constrained FastRelax -->
        <FastRelax
            name="fastrelax"
            scorefxn="beta_cst"
        />

    </MOVERS>

    <PROTOCOLS>

        <Add mover_name="set_virtual_root"/>
        <Add mover_name="add_bb_ca_cst"/>
        <Add mover_name="fastrelax"/>

    </PROTOCOLS>

    <!-- Score final structure without the constraint score term -->
    <OUTPUT
        scorefxn="beta"
    />

</ROSETTASCRIPTS>